{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "captcha-angular": {
      "projectType": "library",
      "root": "projects/captcha-angular",
      "sourceRoot": "projects/captcha-angular",
      "prefix": "captcha",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/captcha-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/captcha-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/captcha-angular/tsconfig.spec.json",
            "coverageThresholds": {
              "lines": 80
            },
            "coverageExclude": [
              "**/*.spec.ts",
              "**/testing/**"
            ],
            "include": [
              "src/**/*.spec.ts",
              "worker/**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/captcha-angular/**/*.ts",
              "projects/captcha-angular/**/*.html"
            ]
          }
        }
      }
    },
    "captcha-sample": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/captcha-sample",
      "sourceRoot": "projects/captcha-sample/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/captcha-sample/src/main.ts",
            "tsConfig": "projects/captcha-sample/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/captcha-sample/public"
              }
            ],
            "styles": [
              "projects/captcha-sample/src/styles.scss"
            ],
            "webWorkerTsConfig": "projects/captcha-sample/tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "captcha-sample:build:production"
            },
            "development": {
              "buildTarget": "captcha-sample:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/captcha-sample/**/*.ts",
              "projects/captcha-sample/**/*.html"
            ]
          }
        }
      }
    }
  }
}
